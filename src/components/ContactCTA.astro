---
import ProjectBlock from "./ProjectBlock.astro";
import { siteContent } from "../data/projects";
---

<ProjectBlock>
  <aside class="cta">
    <p class="cta-text">Want to learn more? Let's connect.</p>
    <div class="cta-links">
      <a href={`mailto:${siteContent.email}`} class="button button--primary">Email</a>
      <a href={siteContent.linkedin} target="_blank" rel="noopener noreferrer" class="button button--secondary">LinkedIn</a>
    </div>
  </aside>
</ProjectBlock>

<style>
  .cta {
    text-align: center;
    padding: var(--space-md) 0;
  }

  .cta-text {
    font-size: var(--text-lg);
    color: var(--color-text);
    margin-bottom: var(--space-md);
  }

  .cta-links {
    display: flex;
    justify-content: center;
    gap: var(--space-md);
  }
</style>
