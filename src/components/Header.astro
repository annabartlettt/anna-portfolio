---
import { siteContent } from "../data/projects";

interface Props {
  brandColor?: string;
  heroTextColor?: "light" | "dark";
}

const { brandColor, heroTextColor } = Astro.props;
const hasBranded = !!brandColor;
---

<header
  class:list={[
    "header",
    { "header--branded": hasBranded },
    { "header--light": heroTextColor === "light" },
    { "header--dark": heroTextColor === "dark" },
  ]}
  style={brandColor ? `background-color: ${brandColor};` : undefined}
>
  <div class="container header-inner">
    <a href="/" class="logo" aria-label="Home">{siteContent.name}</a>
    <nav class="nav" aria-label="Main navigation">
      <a href="/projects">Projects</a>
      <a href="/about">About</a>
    </nav>
  </div>
</header>

<style>
  /* Header-scoped theme tokens */
  .header {
    --header-bg: #688b6c;
    --header-fg: #f3f9f3;
    background-color: var(--header-bg);
    border-bottom-color: rgba(255, 255, 255, 0.1);
  }

  .header .logo {
    color: var(--header-fg);
  }

  .header .nav a {
    color: var(--header-fg);
    opacity: 0.85;
  }

  .header .nav a:hover {
    opacity: 0.65;
  }

  /* Branded header - light text variant (for dark backgrounds) */
  .header--light {
    --header-fg: rgba(255, 255, 255, 0.95);
  }

  .header--light .nav a {
    opacity: 0.75;
  }

  .header--light .nav a:hover {
    opacity: 1;
  }

  .header--light.header--branded {
    border-bottom-color: rgba(255, 255, 255, 0.1);
  }

  /* Branded header - dark text variant (for light backgrounds) */
  .header--dark.header--branded .logo {
    color: rgba(0, 0, 0, 0.9);
  }

  .header--dark.header--branded .nav a {
    color: rgba(0, 0, 0, 0.6);
  }

  .header--dark.header--branded .nav a:hover {
    opacity: 1;
    color: rgba(0, 0, 0, 0.9);
  }

  .header--dark.header--branded {
    border-bottom-color: rgba(0, 0, 0, 0.08);
  }
</style>
