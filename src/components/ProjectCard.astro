---
import type { Project } from "../data/projects";
import { isCaseStudy } from "../data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const brandColor = isCaseStudy(project) && project.brandColor ? project.brandColor : null;
---

<a
  href={`/projects/${project.slug}`}
  class="project-card"
  style={brandColor ? `--card-brand-color: ${brandColor}` : undefined}
>
  <div class="project-card-image">
    <img src={project.thumbnail} alt={`${project.title} thumbnail`} loading="lazy" />
  </div>
  <div class="project-card-content">
    <h3 class="project-card-title">{project.title}</h3>
    <div class="project-card-meta">
      <span>{project.summary}</span>
      <span>&middot;</span>
      <span>{project.year}</span>
    </div>
  </div>
</a>
