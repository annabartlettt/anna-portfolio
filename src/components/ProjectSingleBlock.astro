---
import ProjectBlock from "./ProjectBlock.astro";

interface Props {
  kicker?: string;
  title: string;
  content: string;
}

const { kicker, title, content } = Astro.props;
---

<ProjectBlock>
  <div class="single">
    {kicker && <div class="single__kicker">{kicker}</div>}
    <h2 class="single__title">{title}</h2>
    <p class="single__content">{content}</p>
  </div>
</ProjectBlock>

<style>
  .single {
    max-width: 600px;
  }

  .single__kicker {
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-text-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: var(--space-sm);
    opacity: 0.7;
  }

  .single__title {
    font-size: var(--text-lg);
    font-weight: 500;
    color: var(--color-text);
    letter-spacing: -0.01em;
    margin-bottom: var(--space-md);
  }

  .single__content {
    font-size: var(--text-base);
    line-height: var(--leading-loose);
    color: var(--color-text-secondary);
  }
</style>
