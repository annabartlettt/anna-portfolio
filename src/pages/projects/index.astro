---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { caseStudies, visualProjects } from "../../data/projects";
---

<Layout title="Projects" description="UX/Product case studies and visual explorations by Anna Bartlett.">
  <Header />

  <main>
    <section class="page-header">
      <div class="container">
        <h1>Projects</h1>
        <p class="page-intro">A selection of UX/product work and visual explorations.</p>
      </div>
    </section>

    <!-- Case Studies Section -->
    <section class="section projects-section">
      <div class="container">
        <div class="section-header">
          <h2>UX / Product</h2>
          <p class="text-secondary">Case studies exploring user-centered design solutions.</p>
        </div>
        <div class="projects-grid">
          {caseStudies.map((project) => <ProjectCard project={project} />)}
        </div>
      </div>
    </section>

    <!-- Visual Projects Section -->
    <section class="section projects-section">
      <div class="container">
        <div class="section-header">
          <h2>Visual / Explorations</h2>
          <p class="text-secondary">Creative coding, net art, and graphic design work.</p>
        </div>
        <div class="projects-grid">
          {visualProjects.map((project) => <ProjectCard project={project} />)}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .page-header {
    padding-top: calc(var(--space-3xl) + 60px);
    padding-bottom: var(--space-xl);
  }

  .page-intro {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    max-width: 540px;
    margin-top: var(--space-sm);
  }

  .projects-section {
    padding-top: var(--space-xl);
    padding-bottom: var(--space-2xl);
  }

  .projects-section:first-of-type {
    padding-top: 0;
  }

  .section-header {
    margin-bottom: var(--space-lg);
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--color-border);
  }

  .section-header h2 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-xs);
  }

  .section-header p {
    font-size: var(--text-base);
  }
</style>
