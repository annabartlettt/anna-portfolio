---
import Layout from "../../layouts/Layout.astro";
import CaseStudyLayout from "../../layouts/CaseStudyLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ProjectSection from "../../components/ProjectSection.astro";
import ProjectSectionPair from "../../components/ProjectSectionPair.astro";
import ProjectTextPair from "../../components/ProjectTextPair.astro";
import ProjectSingleBlock from "../../components/ProjectSingleBlock.astro";
import ProjectImageBlock from "../../components/ProjectImageBlock.astro";
import ProjectImage from "../../components/ProjectImage.astro";
import ProjectNav from "../../components/ProjectNav.astro";
import ContactCTA from "../../components/ContactCTA.astro";
import {
  projects,
  visualProjects,
  isCaseStudy,
  isVisualProject,
} from "../../data/projects";
import type { Project, CaseStudy, VisualProject } from "../../data/projects";


export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;

// Visual project navigation
const visualIndex = visualProjects.findIndex((p) => p.slug === project.slug);
const prevVisual = visualIndex > 0 ? visualProjects[visualIndex - 1] : null;
const nextVisual = visualIndex < visualProjects.length - 1 ? visualProjects[visualIndex + 1] : null;

// Check if case study has paired sections
const hasPairedIntro = isCaseStudy(project) && project.context;

// Check for Vetted case study (has custom icon)
const isVetted = project.slug === "vetted";
---

{isCaseStudy(project) ? (
  <CaseStudyLayout project={project} showIcon={isVetted} iconStyle="frame">
    {isVetted && (
      <svg slot="hero-icon" viewBox="0 0 263 213" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" class="hero-icon-svg">
        <path d="M262.459 7.74323C256.823 7.74323 252.595 9.7632 250.129 13.4665C247.663 17.5064 245.901 20.5364 244.492 22.893L169.806 180.114C167.34 185.501 165.226 189.877 163.465 192.907C161.703 195.937 160.999 198.294 160.999 199.641C160.999 200.987 160.999 201.997 162.055 203.007C162.76 203.681 163.817 204.69 164.874 205.364V212.77H100.052V205.364C102.518 204.354 103.927 202.334 103.927 199.641C103.927 198.294 102.87 195.601 100.756 191.224C98.6424 186.847 96.1764 181.797 93.0057 175.738C92.3011 174.054 45.7983 77.7689 45.446 77.0956L40.5138 66.6591C40.5138 66.3224 17.2624 18.5164 16.9101 17.8431C15.8532 16.1598 14.4441 13.1298 10.9211 11.4465C8.45506 10.0999 4.57983 8.75321 0 7.40656V0H75.7433V7.40656C73.6295 7.40656 71.868 7.74322 70.1066 8.75321C68.3451 9.7632 67.2882 11.4465 67.2882 14.1398C67.2882 17.1698 68.3451 20.873 70.8112 25.5863C73.6295 31.3096 76.0956 37.0328 79.6185 42.4194C83.8461 49.1526 91.5965 63.6291 107.097 98.9786C108.154 98.9786 109.564 99.6519 111.325 99.9886C120.132 102.345 120.837 102.009 121.894 102.682C125.769 104.702 127.178 113.118 129.997 130.288C130.349 132.645 131.053 137.358 134.576 141.398C136.338 143.081 137.747 144.428 139.156 145.101C145.498 147.121 151.134 146.448 152.896 143.755C153.248 143.081 153.953 141.398 153.6 139.715C153.6 138.368 152.896 137.358 151.839 135.675C149.725 132.645 147.259 130.962 146.907 130.625C137.395 122.882 161.351 72.3823 177.556 71.709C179.318 71.709 182.488 73.3923 187.421 73.0557C192.353 73.0557 194.819 71.3723 195.876 70.3624C196.933 69.3524 197.285 68.679 197.637 68.0057C197.989 66.9957 198.694 65.6491 199.399 63.9658C199.399 63.9658 200.103 60.9358 200.103 57.9059C200.103 49.4893 194.114 46.1227 195.523 39.7261C195.876 37.7061 196.58 37.3695 197.989 32.9929C199.399 28.6163 200.103 25.923 199.046 24.913C197.989 24.2397 195.171 24.913 187.421 31.6462C187.421 21.2097 188.125 11.1098 188.477 0.673324H262.459V8.07989V7.74323Z" fill="currentColor"/>
        <path d="M143.736 26.6507C143.736 26.9658 143.736 27.2889 143.736 27.604C143.736 27.7373 143.736 27.8706 143.736 27.9999C143.736 32.1727 143.74 36.3658 143.736 40.5386C143.736 40.6962 143.736 40.8578 143.736 41.0153C143.736 41.3304 143.736 41.6536 143.736 41.9686C143.736 45.0952 143.943 48.6137 143.736 51.6918C143.009 62.4007 128.746 62.1866 127.903 52.326C127.62 49.0217 128.114 45.3497 127.903 42.009V26.6103C128.131 23.205 127.595 19.4159 127.903 16.055C128.766 6.61858 142.996 6.19847 143.736 16.8467C143.952 19.941 143.736 23.4998 143.736 26.6507Z" fill="currentColor"/>
        <path d="M142.133 16.352C142.108 28.4101 142.079 40.4641 142.054 52.5221C141.685 55.879 138.682 58.3552 135.367 58.1977C132.277 58.0482 129.656 55.6406 129.32 52.5181C129.345 40.4641 129.374 28.406 129.399 16.352C129.573 12.9871 132.493 10.3452 135.891 10.4139C139.197 10.4785 141.963 13.08 142.129 16.352H142.133Z" fill="currentColor"/>
        <path d="M127.55 26.8368C127.874 26.8368 128.207 26.8368 128.53 26.8368C128.668 26.8368 128.805 26.8368 128.938 26.8368C133.228 26.8368 137.539 26.8327 141.83 26.8368C141.992 26.8368 142.158 26.8368 142.32 26.8368C142.644 26.8368 142.976 26.8368 143.3 26.8368C146.515 26.8368 150.133 26.6348 153.298 26.8368C164.309 27.5437 164.088 41.4155 153.95 42.2355C150.552 42.5102 146.777 42.0295 143.342 42.2355H127.509C124.007 42.0133 120.111 42.5344 116.656 42.2355C106.953 41.3953 106.521 27.5558 117.47 26.8368C120.651 26.6267 124.311 26.8368 127.55 26.8368Z" fill="currentColor"/>
      </svg>
    )}
    <!-- Block 1: Overview + Context paired -->
    {hasPairedIntro ? (
      <ProjectSectionPair
        leftKicker="01"
        leftTitle="Overview"
        leftContent={project.overview}
        rightKicker="02"
        rightTitle="Context"
        rightContent={project.context!}
      />
    ) : (
      <ProjectSingleBlock
        kicker="01"
        title="Overview"
        content={project.overview}
      />
    )}

    <!-- Block 2: Problem + Approach paired -->
    <ProjectTextPair
      leftKicker="03"
      leftTitle="Problem"
      leftContent={project.problem}
      rightKicker="04"
      rightTitle="Approach"
      rightContent={project.approach}
    />

    <!-- Block 3: Image blocks (if imageBlocks exists) -->
    {project.imageBlocks && project.imageBlocks.map((block) => (
      <ProjectImageBlock
        title={block.title}
        images={block.images}
        layout={block.layout}
      />
    ))}

    <!-- Fallback: Legacy gallery (if no imageBlocks but gallery exists) -->
    {!project.imageBlocks && project.gallery && project.gallery.length > 0 && (
      <ProjectImageBlock
        images={project.gallery}
        layout={project.gallery.length > 1 ? "grid" : "single"}
      />
    )}

    <!-- Solution (optional) -->
    {project.solution && (
      <ProjectSingleBlock
        kicker="05"
        title="Solution"
        content={project.solution}
      />
    )}

    <!-- Outcome -->
    <ProjectSingleBlock
      kicker={project.solution ? "06" : "05"}
      title="Outcome"
      content={project.outcome}
    />

    <!-- Key Impacts (optional) -->
    {project.keyImpacts && project.keyImpacts.length > 0 && (
      <ProjectSingleBlock
        title="Key Impacts"
        content={`<ul>${project.keyImpacts.map(impact => `<li>${impact}</li>`).join('')}</ul>`}
      />
    )}

    <!-- Reflection (optional) -->
    {project.reflection && (
      <ProjectSingleBlock
        title="Reflection"
        content={project.reflection}
      />
    )}

    <!-- Credits (optional) -->
    {project.credits && (
      <ProjectSingleBlock
        title="Credits"
        content={project.credits}
      />
    )}
  </CaseStudyLayout>
) : (
  <!-- VISUAL PROJECT TEMPLATE -->
  <Layout title={project.title} description={project.summary}>
    <Header />

    <main>
      <article class="visual-project">
        <section class="project-hero visual-hero">
          <div class="container">
            <span class="project-type-label">Visual / Exploration</span>
            <h1>{project.title}</h1>
            {project.description && (
              <p class="visual-description">{project.description}</p>
            )}
            <p class="visual-meta">{project.role} · {project.year}</p>
          </div>
        </section>

        <section class="visual-gallery-section">
          <div class="container">
            {project.images.length > 0 && (
              <div class="visual-gallery">
                {project.images.map((image, index) => (
                  <figure class="visual-gallery-item">
                    <img
                      src={image}
                      alt={`${project.title} - Image ${index + 1}`}
                      loading="lazy"
                    />
                  </figure>
                ))}
              </div>
            )}
          </div>
        </section>

        <section class="section">
          <div class="container">
            <ContactCTA />
            <nav class="visual-nav" aria-label="Project navigation">
              {prevVisual ? (
                <a href={`/projects/${prevVisual.slug}`}>
                  &larr; {prevVisual.title}
                </a>
              ) : (
                <a href="/projects">&larr; All Projects</a>
              )}
              {nextVisual ? (
                <a href={`/projects/${nextVisual.slug}`}>
                  {nextVisual.title} &rarr;
                </a>
              ) : (
                <a href="/projects">All Projects &rarr;</a>
              )}
            </nav>
          </div>
        </section>
      </article>
    </main>

    <Footer />
  </Layout>
)}

<style>
  /* Hero icon SVG sizing */
  .hero-icon-svg {
    width: 40px;
    height: auto;
    max-height: 40px;
  }

  /* Visual project styles */
  .project-type-label {
    display: block;
    font-size: var(--text-sm);
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: var(--space-sm);
  }

  .visual-hero {
    padding-top: calc(var(--space-3xl) + 60px);
    padding-bottom: var(--space-lg);
  }

  .visual-description {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    max-width: 600px;
    margin-top: var(--space-sm);
    line-height: 1.5;
  }

  .visual-meta {
    font-size: var(--text-sm);
    color: var(--color-text-tertiary);
    margin-top: var(--space-md);
  }

  .visual-gallery-section {
    padding-bottom: var(--space-2xl);
  }

  .visual-gallery {
    display: grid;
    gap: var(--space-md);
  }

  .visual-gallery-item {
    margin: 0;
  }

  .visual-gallery-item img {
    width: 100%;
  }

  @media (min-width: 768px) {
    .visual-gallery {
      grid-template-columns: repeat(2, 1fr);
    }

    .visual-gallery-item:first-child {
      grid-column: 1 / -1;
    }
  }

  .visual-nav {
    display: flex;
    justify-content: space-between;
    padding: var(--space-xl) 0;
    border-top: 1px solid var(--color-border);
  }

  .visual-nav a {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    transition: color 150ms ease;
  }

  .visual-nav a:hover {
    color: var(--color-text);
  }
</style>
