---
import Layout from "../../layouts/Layout.astro";
import CaseStudyLayout from "../../layouts/CaseStudyLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ProjectSection from "../../components/ProjectSection.astro";
import ProjectSectionPair from "../../components/ProjectSectionPair.astro";
import ProjectTextPair from "../../components/ProjectTextPair.astro";
import ProjectSingleBlock from "../../components/ProjectSingleBlock.astro";
import ProjectImageBlock from "../../components/ProjectImageBlock.astro";
import ProjectImage from "../../components/ProjectImage.astro";
import ProjectNav from "../../components/ProjectNav.astro";
import ContactCTA from "../../components/ContactCTA.astro";
import {
  projects,
  visualProjects,
  isCaseStudy,
  isVisualProject,
} from "../../data/projects";
import type { Project, CaseStudy, VisualProject } from "../../data/projects";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;

// Visual project navigation
const visualIndex = visualProjects.findIndex((p) => p.slug === project.slug);
const prevVisual = visualIndex > 0 ? visualProjects[visualIndex - 1] : null;
const nextVisual = visualIndex < visualProjects.length - 1 ? visualProjects[visualIndex + 1] : null;

// Check if case study has paired sections
const hasPairedIntro = isCaseStudy(project) && project.context;
---

{isCaseStudy(project) ? (
  <CaseStudyLayout project={project}>
    <!-- Block 1: Overview + Context paired -->
    {hasPairedIntro ? (
      <ProjectSectionPair
        leftKicker="01"
        leftTitle="Overview"
        leftContent={project.overview}
        rightKicker="02"
        rightTitle="Context"
        rightContent={project.context!}
      />
    ) : (
      <ProjectSingleBlock
        kicker="01"
        title="Overview"
        content={project.overview}
      />
    )}

    <!-- Block 2: Problem + Approach paired -->
    <ProjectTextPair
      leftKicker="03"
      leftTitle="Problem"
      leftContent={project.problem}
      rightKicker="04"
      rightTitle="Approach"
      rightContent={project.approach}
    />

    <!-- Block 3: Image blocks (if imageBlocks exists) -->
    {project.imageBlocks && project.imageBlocks.map((block) => (
      <ProjectImageBlock
        title={block.title}
        images={block.images}
        layout={block.layout}
      />
    ))}

    <!-- Fallback: Legacy gallery (if no imageBlocks but gallery exists) -->
    {!project.imageBlocks && project.gallery && project.gallery.length > 0 && (
      <ProjectImageBlock
        images={project.gallery}
        layout={project.gallery.length > 1 ? "grid" : "single"}
      />
    )}

    <!-- Solution (optional) -->
    {project.solution && (
      <ProjectSingleBlock
        kicker="05"
        title="Solution"
        content={project.solution}
      />
    )}

    <!-- Outcome -->
    <ProjectSingleBlock
      kicker={project.solution ? "06" : "05"}
      title="Outcome"
      content={project.outcome}
    />

    <!-- Key Impacts (optional) -->
    {project.keyImpacts && project.keyImpacts.length > 0 && (
      <ProjectSingleBlock
        title="Key Impacts"
        content={`<ul>${project.keyImpacts.map(impact => `<li>${impact}</li>`).join('')}</ul>`}
      />
    )}

    <!-- Reflection (optional) -->
    {project.reflection && (
      <ProjectSingleBlock
        title="Reflection"
        content={project.reflection}
      />
    )}

    <!-- Credits (optional) -->
    {project.credits && (
      <ProjectSingleBlock
        title="Credits"
        content={project.credits}
      />
    )}
  </CaseStudyLayout>
) : (
  <!-- VISUAL PROJECT TEMPLATE -->
  <Layout title={project.title} description={project.summary}>
    <Header />

    <main>
      <article class="visual-project">
        <section class="project-hero visual-hero">
          <div class="container">
            <span class="project-type-label">Visual / Exploration</span>
            <h1>{project.title}</h1>
            {project.description && (
              <p class="visual-description">{project.description}</p>
            )}
            <p class="visual-meta">{project.role} · {project.year}</p>
          </div>
        </section>

        <section class="visual-gallery-section">
          <div class="container">
            {project.images.length > 0 && (
              <div class="visual-gallery">
                {project.images.map((image, index) => (
                  <figure class="visual-gallery-item">
                    <img
                      src={image}
                      alt={`${project.title} - Image ${index + 1}`}
                      loading="lazy"
                    />
                  </figure>
                ))}
              </div>
            )}
          </div>
        </section>

        <section class="section">
          <div class="container">
            <ContactCTA />
            <nav class="visual-nav" aria-label="Project navigation">
              {prevVisual ? (
                <a href={`/projects/${prevVisual.slug}`}>
                  &larr; {prevVisual.title}
                </a>
              ) : (
                <a href="/projects">&larr; All Projects</a>
              )}
              {nextVisual ? (
                <a href={`/projects/${nextVisual.slug}`}>
                  {nextVisual.title} &rarr;
                </a>
              ) : (
                <a href="/projects">All Projects &rarr;</a>
              )}
            </nav>
          </div>
        </section>
      </article>
    </main>

    <Footer />
  </Layout>
)}

<style>
  /* Visual project styles */
  .project-type-label {
    display: block;
    font-size: var(--text-sm);
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: var(--space-sm);
  }

  .visual-hero {
    padding-top: calc(var(--space-3xl) + 60px);
    padding-bottom: var(--space-lg);
  }

  .visual-description {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    max-width: 600px;
    margin-top: var(--space-sm);
    line-height: 1.5;
  }

  .visual-meta {
    font-size: var(--text-sm);
    color: var(--color-text-tertiary);
    margin-top: var(--space-md);
  }

  .visual-gallery-section {
    padding-bottom: var(--space-2xl);
  }

  .visual-gallery {
    display: grid;
    gap: var(--space-md);
  }

  .visual-gallery-item {
    margin: 0;
  }

  .visual-gallery-item img {
    width: 100%;
  }

  @media (min-width: 768px) {
    .visual-gallery {
      grid-template-columns: repeat(2, 1fr);
    }

    .visual-gallery-item:first-child {
      grid-column: 1 / -1;
    }
  }

  .visual-nav {
    display: flex;
    justify-content: space-between;
    padding: var(--space-xl) 0;
    border-top: 1px solid var(--color-border);
  }

  .visual-nav a {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    transition: color 150ms ease;
  }

  .visual-nav a:hover {
    color: var(--color-text);
  }
</style>
