---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getFeaturedCaseStudies, siteContent } from "../data/projects";

const featuredCaseStudies = getFeaturedCaseStudies();
---

<Layout>
  <Header />

  <main>
    <!-- Hero Section -->
    <section class="hero hero--landing">
      <div class="container">
        <h1 class="hero-title">{siteContent.name}</h1>
        <p class="hero-tagline">{siteContent.tagline}</p>
        <p class="hero-intro">{siteContent.intro}</p>
      </div>
    </section>

    <!-- Featured Case Studies Section -->
    <section id="work" class="section">
      <div class="container">
        <div class="projects-header">
          <h2>Selected Work</h2>
          <a href="/projects" class="button button--secondary">View all projects</a>
        </div>
        <div class="projects-grid">
          {featuredCaseStudies.map((project) => <ProjectCard project={project} />)}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* Landing page hero theme - scoped color palette */
  .hero--landing {
    --landing-bg: #afc5e8;
    --landing-name: #688b6c;
    --landing-surface: #f3f9f3;

    background-color: var(--landing-bg);
    margin-left: calc(-50vw + 50%);
    margin-right: calc(-50vw + 50%);
    padding-left: calc(50vw - 50%);
    padding-right: calc(50vw - 50%);
  }

  .hero--landing .hero-title {
    color: var(--landing-name);
  }
</style>
